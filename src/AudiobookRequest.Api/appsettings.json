{
  "ConnectionStrings": {
    "Default": "Data Source=data/app.db"
  },
  "DataProtectionKeysPath": "data/keys",
  "Ffmpeg": {
    "Path": "ffmpeg",
    "ProbePath": "ffprobe"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "data/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
